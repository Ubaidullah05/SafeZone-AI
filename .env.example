# Frontend (Vite) - copy to frontend/.env
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend PostgreSQL connection
DATABASE_URL=postgresql://user:password@localhost:5432/safelink
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safelink
DB_USER=postgres
DB_PASSWORD=

# Optional: override individual DB vars instead of DATABASE_URL
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=safelink
# DB_USER=postgres
# DB_PASSWORD=

# Other settings
SAFEZONE_DEMO_MODE=0
MAP_TILE_PROVIDER=osm
