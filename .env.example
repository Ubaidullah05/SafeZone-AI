# Frontend (Vite) - copy to frontend/.env
#
# VITE_API_URL: leave EMPTY for local dev. When empty, the frontend calls
# relative /api and /ws paths, which the Vite dev server proxies to the
# backend on 127.0.0.1:8000. That works from phones/tablets on the same LAN
# because the proxy runs on YOUR machine - do NOT put an IP address here.
# Set it only for production, where the API lives on a different host.
# VITE_API_URL=https://api.example.com

# Backend PostgreSQL connection
DATABASE_URL=postgresql://user:password@localhost:5432/safelink
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safelink
DB_USER=postgres
DB_PASSWORD=

# Optional: override individual DB vars instead of DATABASE_URL
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=safelink
# DB_USER=postgres
# DB_PASSWORD=

# Other settings
SAFEZONE_DEMO_MODE=0
MAP_TILE_PROVIDER=osm

# CORS allowlist (REQUIRED in production, comma-separated origins).
# The backend does not accept wildcard origins. Leave unset locally - the
# Vite dev server proxies /api and /ws server-side so requests are
# same-origin and CORS never applies. In production set this to the real
# frontend origin, e.g. https://your-app.vercel.app
# SAFEZONE_CORS_ORIGINS=
